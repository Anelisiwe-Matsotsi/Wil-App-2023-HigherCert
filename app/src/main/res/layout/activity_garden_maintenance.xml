<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#97E4E9"
    android:fillViewport="true"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="0.0"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="1.0">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        tools:context=".GardenMaintenance">


        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#157581">


            <ImageView
                android:id="@+id/imageViewL4"
                android:layout_width="match_parent"
                android:layout_height="199dp"
                android:layout_gravity="top"
                android:background="#FFFFFF"
                android:contentDescription="TODO"
                app:srcCompat="@drawable/thumbnail_img_7280" />

            <TextView
                android:id="@+id/textViewGarden"
                android:layout_width="wrap_content"
                android:layout_height="59dp"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="230dp"
                android:text="    Garden Maintenance"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/textViewText4"
                android:layout_width="304dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="50dp"
                android:layout_marginTop="500dp"

                android:text="Learn to manage their gardens efficiently, with insights on optimizing water usage, addressing the needs of indigenous and exotic plants, mastering trimming techniques, and plant propagation methods. "
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <ImageView
                android:id="@+id/imageViewGardenMain"
                android:layout_width="260dp"
                android:layout_height="180dp"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="880dp"
                app:srcCompat="@drawable/garden" />

            <TextView
                android:id="@+id/textViewText5"
                android:layout_width="340dp"
                android:layout_height="155dp"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="320dp"
                android:background="#f3d89d"
                android:text=" Head\n Instructor \n\nThabiso \nModise"
                android:textAlignment="textStart"
                android:textColor="#0E0E0E"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/imageViewThabiso"
                android:layout_width="218dp"
                android:layout_height="200dp"
                android:layout_marginLeft="235dp"
                android:layout_marginTop="300dp"
                app:srcCompat="@drawable/thabiso_modise_g1_" />

            <TextView
                android:id="@+id/textViewText6"
                android:layout_width="228dp"
                android:layout_height="82dp"
                android:layout_marginLeft="80dp"
                android:layout_marginTop="1080dp"
                android:text="Fees: \nR750"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <Button
                android:id="@+id/buttonBookNow2"
                android:layout_width="200dp"
                android:layout_height="92dp"
                android:layout_marginLeft="90dp"
                android:layout_marginTop="1180dp"
                android:text="Book Now!"
                android:textColor="#4CAF50"
                android:textSize="24sp" />


        </FrameLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="20dp"
            android:background="#FF9800"
            android:scrollIndicators="left"
            app:itemTextColor="#0C0B0B"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/nav_menu" />
    </RelativeLayout>

</ScrollView>