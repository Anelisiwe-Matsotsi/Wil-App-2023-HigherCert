<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ScrollViewMonths"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#157581"
        tools:context=".HomeFragment">

        <!-- Header -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="200dp"
            android:text="Contact Us"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Image Banner -->
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@color/white"
            android:src="@drawable/thumbnail_img_7280" />

        <!-- Slogan and Contact Information -->
        <TextView
            android:id="@+id/textViewSlogan"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="290dp"
            android:background="@android:color/holo_orange_dark"
            android:text="EMPOWERING THE NATION"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="30sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/map1"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="650dp"
            android:text="Venue 1, IIE VARSITY COLLEGE"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="700dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/map_1" />
        <TextView
            android:id="@+id/map2"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="1050dp"
            android:text="Venue 2, City Varsity Braamfontein"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="1100dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/map_2" />

        <TextView
            android:id="@+id/mapview"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="370dp"
            android:autoLink="phone"
            android:background="@android:color/holo_orange_dark"
            android:padding="16dp"
            android:text="Phone: +27 748873445"
            android:textAlignment="center"
            android:textSize="25sp" />
        <TextView
            android:id="@+id/map3"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="1450dp"
            android:text="Venue 2, City Varsity Braamfontein"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="1500dp"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/map_3" />
        <TextView
            android:id="@+id/emailView"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="450dp"
            android:autoLink="email"
        android:background="@android:color/holo_blue_dark"
        android:padding="16dp"
        android:text="Email:info@empoweringthenation.com"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />

    </FrameLayout>
</ScrollView>
