<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ScrollViewMonths"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#157581"
        tools:context=".HomeFragment">

        <!-- Header -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="2055dp"
            android:background="#157581">


            <!-- Image Banner -->

            <!-- Slogan and Contact Information -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="420dp"
                android:layout_height="222dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/thumbnail_img_7280" />

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginTop="260dp"
                android:text="Contact Us"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textViewSlogan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="372dp"
                android:background="#157581"
                android:text="EMPOWERING THE NATION"
                android:textAlignment="center"
                android:textColor="#FFF1F1"
                android:textSize="30sp"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/map1"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="1156dp"
                android:text="Venue 1, IIE VARSITY COLLEGE"
                android:textAlignment="center"
                android:textColor="#EAE08D"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imageView10"
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="856dp"
                android:src="@drawable/map_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/map2"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginBottom="316dp"
                android:text="Venue 2, City Varsity Braamfontein"
                android:textAlignment="center"
                android:textColor="#EAE08D"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imageView12"
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="476dp"
                android:layout_marginBottom="440dp"
                android:src="@drawable/map_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/mapview"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:autoLink="phone"
                android:background="#838382"
                android:padding="16dp"
                android:text="Phone: +27 748873445"
                android:textAlignment="center"
                android:textSize="25sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.218" />

            <TextView
                android:id="@+id/map3"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginBottom="752dp"
                android:text="Venue 2, City Varsity Braamfontein"
                android:textAlignment="center"
                android:textColor="#EAE08D"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/imageView14"
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:layout_gravity="center_horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/map_3" />

            <TextView
                android:id="@+id/emailView"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="524dp"
                android:autoLink="email"
                android:background="@android:color/holo_blue_dark"
                android:padding="16dp"
                android:text="info@empoweringthenation.com"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/w"
                android:layout_width="match_parent"
                android:layout_height="77dp"
                android:layout_marginTop="596dp"
                android:text="Follow Us On:"
                android:textAlignment="center"
                android:textColor="#EAE08D"
                android:textSize="34sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="460dp"
                android:layout_height="74dp"
                android:layout_marginBottom="1300dp"
                android:background="@android:color/holo_blue_dark"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.197"
                app:layout_constraintStart_toStartOf="parent">


                <ImageView
                    android:id="@+id/facebookIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/zbf" />

                <ImageView
                    android:id="@+id/twitterIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="100dp"
                    android:src="@drawable/twt" />

                <ImageView
                    android:id="@+id/instaIcon"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginStart="80dp"
                    android:src="@drawable/insta" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</ScrollView>
