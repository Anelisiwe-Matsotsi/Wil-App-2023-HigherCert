<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ScrollViewMonths"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#97e4e9"
        tools:context=".HomeFragment">

        <!-- Header -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="200dp"
            android:background="@color/white"
            android:text="Contact Us"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="34sp"
            android:textStyle="bold" />

        <!-- Image Banner -->

        <!-- Slogan and Contact Information -->
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="364dp"
            android:layout_height="164dp"
            android:background="@color/white"
            android:src="@drawable/thumbnail_img_7280" />

        <!-- Secondary Images -->

        <TextView
            android:id="@+id/textViewSlogan"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:layout_marginTop="290dp"
            android:background="@android:color/holo_orange_dark"
            android:text="EMPOWERING THE NATION"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="30sp"

            android:textStyle="bold|italic" />





        <!-- Google Maps -->



        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="700dp"
            android:src="@drawable/map_1" />

        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="1100dp"
            android:src="@drawable/map_2" />
        <TextView
            android:id="@+id/phoneNumberTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: +27 748873445"
            android:autoLink="phone"
            android:layout_marginTop="380dp"
            android:textSize="20sp"
            android:background="@android:color/holo_orange_dark"
            android:padding="16dp"/>

        <TextView
            android:id="@+id/mapview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone: +27 748873445"
            android:autoLink="phone"
            android:layout_marginTop="380dp"
            android:textSize="20sp"
            android:background="@android:color/holo_orange_dark"
            android:padding="16dp"/>



    </FrameLayout>

</ScrollView>
