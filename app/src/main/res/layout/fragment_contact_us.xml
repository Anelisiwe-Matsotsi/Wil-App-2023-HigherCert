<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ScrollViewMonths"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#157581"
        tools:context=".HomeFragment">

        <!-- Header -->


        <!-- Image Banner -->
        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="180dp"
            android:text="Contact Us"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="34sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:background="@color/white"
            android:src="@drawable/thumbnail_img_7280" />

        <!-- Slogan and Contact Information -->
        <TextView
            android:id="@+id/textViewSlogan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="250dp"
            android:background="#157581"
            android:text="EMPOWERING THE NATION"
            android:textAlignment="center"
            android:textColor="#050505"
            android:textSize="27sp"
            android:textStyle="bold|italic" />

        <TextView
            android:id="@+id/map1"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="705dp"
            android:text="Venue 1, IIE VARSITY COLLEGE"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView10"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="750dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/map_1" />
        <TextView
            android:id="@+id/map2"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="1100dp"
            android:text="Venue 2, City Varsity Braamfontein"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView12"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="1150dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/map_2" />

        <TextView
            android:id="@+id/mapview"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="310dp"
            android:autoLink="phone"
            android:background="@android:color/holo_orange_dark"
            android:padding="16dp"
            android:text="Phone: +27 748873445"
            android:textAlignment="center"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/map3"
            android:layout_width="match_parent"
            android:layout_height="77dp"
            android:layout_marginTop="1490dp"
            android:text="Venue 2, City Varsity Braamfontein"
            android:textAlignment="center"
            android:textColor="#EAE08D"
            android:textSize="24sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imageView14"
            android:layout_width="wrap_content"
            android:layout_height="300dp"
            android:layout_marginTop="1550dp"
            android:layout_gravity="center_horizontal"
            app:srcCompat="@drawable/map_3" />
        <TextView
            android:id="@+id/emailView"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="399dp"
            android:autoLink="email"
            android:background="@android:color/holo_blue_dark"
            android:padding="16dp"
            android:text="info@empoweringthenation.com"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="25sp" /> <TextView
        android:id="@+id/w"
        android:layout_width="match_parent"
        android:layout_height="77dp"
        android:layout_marginTop="480dp"
        android:text="Follow Us On:"
        android:textAlignment="center"
        android:textColor="#EAE08D"
        android:textSize="34sp"
        android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="550dp">


            <ImageView
                android:id="@+id/facebookIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/zbf"/>



            <ImageView
                android:id="@+id/twitterIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="100dp"
            android:src="@drawable/twt" />
            <ImageView
                android:id="@+id/instaIcon"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="80dp"
                android:src="@drawable/insta"/>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
