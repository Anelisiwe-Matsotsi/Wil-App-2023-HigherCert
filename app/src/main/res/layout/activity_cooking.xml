<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#157581"
    tools:context=".Cooking">


    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/bottomNav"
        android:layout_marginBottom="5dp"
        android:background="#97E4E9"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0">

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#157581">


            <ImageView
                android:id="@+id/imageViewL3"
                android:layout_width="match_parent"
                android:layout_height="199dp"
                android:layout_gravity="top"
                android:background="#FFFFFF"
                android:contentDescription="TODO"
                app:srcCompat="@drawable/thumbnail_img_7280" />

            <TextView
                android:id="@+id/textViewCooking"
                android:layout_width="394dp"
                android:layout_height="114dp"
                android:layout_marginTop="230dp"
                android:text="            Cooking"
                android:textAlignment="center"
                android:textColor="#EAE08D"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewText1"
                android:layout_width="wrap_content"
                android:layout_height="195dp"
                android:layout_marginTop="550dp"
                android:background="#15909F"
                android:text="Explore a world of flavors, master the art of cooking nutritious meals, and enhance your culinary skills."
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="34sp" />

            <ImageView
                android:id="@+id/imageViewCooking"
                android:layout_width="257dp"
                android:layout_height="180dp"
                android:layout_marginLeft="100dp"
                android:layout_marginTop="750dp"
                app:srcCompat="@drawable/mealprep" />

            <TextView
                android:id="@+id/textViewText2"
                android:layout_width="340dp"
                android:layout_height="150dp"
                android:layout_marginLeft="70dp"
                android:layout_marginTop="350dp"
                android:background="#4CAF50"
                android:text=" Head\n Instructor \n \n  Michelle Baker"
                android:textAlignment="textStart"
                android:textColor="#0E0E0E"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/imageViewMichelle"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginLeft="235dp"
                android:layout_marginTop="350dp"
                app:srcCompat="@drawable/michelle_baker_chef1_" />

            <TextView
                android:id="@+id/textViewText3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="950dp"
                android:background="#15909F"
                android:text="Fees: \nR750"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="32sp" />

            <Button
                android:id="@+id/buttonBookNow"
                android:layout_width="234dp"
                android:layout_height="92dp"
                android:layout_marginLeft="90dp"
                android:layout_marginTop="1050dp"
                android:drawableRight="@drawable/ic_checkout_foreground"
                android:text="Book Now!"
                android:textColor="#4CAF50"
                android:textSize="24sp" />


        </FrameLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="17dp"
        android:background="#c2c0bc"
        android:scrollIndicators="left"
        app:itemIconSize="38dp"
        app:itemIconTint="@color/black"
        app:itemTextColor="#0C0B0B"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/nav_menu" />
</RelativeLayout>