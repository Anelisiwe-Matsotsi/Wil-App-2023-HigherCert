<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ScrollViewMonths"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#157581"
        tools:context=".SixMonthCoursesFragment">


        <Button
            android:id="@+id/button"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="1150dp"
            android:background="@drawable/img_7273"
            android:text="Life Skills"
            android:textColor="#090909"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button7"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="1000dp"
            android:background="@drawable/img_7274"
            android:text="Landscaping"
            android:textColor="#090909"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button8"
            android:layout_width="306dp"
            android:layout_height="101dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="700dp"
            android:background="@drawable/img_7279"
            android:text="First Aid"
            android:textColor="#090909"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="335dp"
            android:layout_height="139dp"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="400dp"
            android:background="#157581"
            android:text="Six Month Courses"
            android:textColor="#EAE08D"
            android:textSize="48sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button9"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="70dp"
            android:layout_marginTop="850dp"
            android:background="@drawable/img_7272"
            android:text="Sewing"
            android:textColor="#090909"
            android:textSize="24sp" />


        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="176dp"
            app:srcCompat="@drawable/thumbnail_img_7280" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="550dp"
            android:background="#f3d89d"
            android:text="These are the six month courses, enter any to find out more."
            android:textAlignment="center"
            android:textColor="#0E0E0E"
            android:textSize="24sp" />


    </FrameLayout>
</ScrollView>