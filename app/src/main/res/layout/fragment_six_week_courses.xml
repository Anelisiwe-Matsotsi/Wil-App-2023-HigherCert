<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#157581"
        tools:context=".SixWeekCoursesFragment">

        <Button
            android:id="@+id/button5"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="800dp"
            android:layout_marginRight="59dp"
            android:background="@drawable/garden"
            android:text="Garden Maintenance"
            android:textColor="#090909"
            android:textSize="24sp" />

        <Button
            android:id="@+id/button4"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="470dp"
            android:background="@drawable/child_minding_1"
            android:textColor="#090909"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textView"
            android:layout_width="335dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="250dp"
            android:background="#157581"
            android:text="Six Week Courses"
            android:textColor="#F8F7F7"
            android:textSize="48sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button3"
            android:layout_width="303dp"
            android:layout_height="101dp"
            android:layout_marginLeft="60dp"
            android:layout_marginTop="650dp"
            android:background="@drawable/cooking"
            android:text="Cooking"
            android:textColor="#090909"
            android:textSize="24sp" />

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="match_parent"
            android:layout_height="165dp"
            android:background="@color/white"
            app:srcCompat="@drawable/thumbnail_img_7280" />

        <SearchView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </FrameLayout>
</ScrollView>